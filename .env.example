# Server-only settings. Never include private keys, seed phrases or VITE_ secrets.
NODE_ENV=development
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Optional alternative to Pinata, requiring persistent public uploads.
PUBLIC_BASE_URL=
# Render supplies PORT automatically.
PORT=3000
TRUST_PROXY_HOPS=0
DATA_DIR=./data
# Internal URL on Render; external TLS URL locally. Run npm run db:migrate.
DATABASE_URL=
# Read-only chain worker diagnostic: process one cycle and exit. Omit on Render.
# INDEXER_ONCE=true
# all runs scanning and processing; use scan/process for separate worker services.
INDEXER_ROLE=all
# Pump is the default. Run an additional raydium worker only for legacy LaunchLab history.
INDEXER_PROTOCOL=pump
# Small pilot: watch registered Pump coins and recently viewed/traded mints.
INDEXER_SCOPE=targeted
INDEXER_BACKFILL=false
# Set the same value on web and every worker sharing this RPC URL.
RPC_SHARED_INTERVAL_MS=500
INDEXER_CONCURRENCY=1
INDEXER_PAGE_SIZE=25
INDEXER_SCAN_INTERVAL_MS=15000
INDEXER_MAX_PENDING=10000
# Shared pacing for all RPC requests within this worker; increase if quotas are hit.
INDEXER_RPC_INTERVAL_MS=1000
# Comma-separated moderator wallet public addresses. No private keys.
MODERATOR_WALLETS=
# Public customer code from your Cloudflare Stream player URL, not an API token.
# Creators provision live inputs in your Cloudflare dashboard; ingest keys stay there.
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Server automation: off until a dedicated Cron Job is explicitly configured.
# On web: set only AUTOLAUNCH_ENABLED=true to disable duplicate browser schedules.
# Signing secret belongs ONLY on the automation Cron Job, never web/indexer/VITE_.
AUTOLAUNCH_ENABLED=false
AUTOLAUNCH_DAILY_BUDGET_SOL=0.01
AUTOLAUNCH_INITIAL_BUY_SOL=0
AUTOLAUNCH_WALLET=
AUTOLAUNCH_SECRET_KEY=
