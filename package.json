{
  "name": "yeetnest-launchpad",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted",
    "start": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:import-catalogue": "node server/import-catalogue.js",
    "test": "node --test tests/amounts.test.js tests/api.test.js tests/app-store.test.js tests/buffers.test.js tests/wallet-links.test.js tests/transactions.test.js",
    "test:postgres": "node --test tests/postgres.test.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@dicebear/bottts-neutral": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@raydium-io/raydium-sdk-v2": "0.2.64-alpha",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/wallet-standard-wallet-adapter-base": "^1.1.4",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.0",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.1",
    "lucide": "^0.468.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "overrides": {
